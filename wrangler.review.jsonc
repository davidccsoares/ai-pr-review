{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai-review-batch",
	"main": "src/review-worker.js",
	"compatibility_date": "2026-03-01",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"ai": {
		"binding": "AI"
	},
	// KV namespace for neuron tracking (shared across AI workers)
	// Create with: npx wrangler kv namespace create BOT_KV
	// Then replace the id below with the actual namespace ID
	"kv_namespaces": [
		{ "binding": "BOT_KV", "id": "2360521973a242ffb6a2173389758694" }
	]
}
