{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ai-review-batch",
	"main": "src/review-worker.js",
	"compatibility_date": "2026-03-01",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"ai": {
		"binding": "AI"
	},
	// Self service binding — self-calls don't count as subrequests!
	"services": [
		{ "binding": "SELF", "service": "ai-review-batch" }
	],
	// KV namespace for neuron tracking (shared across AI workers)
	"kv_namespaces": [
		{ "binding": "BOT_KV", "id": "2360521973a242ffb6a2173389758694" }
	],
	"vars": {
		"AZURE_ORG": "https://dev.azure.com/bindtuning"
	}
}
