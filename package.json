{
	"name": "ai-pr-review",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"deploy:pw-context": "wrangler deploy -c wrangler.pw-context.jsonc",
		"deploy:pw-push": "wrangler deploy -c wrangler.pw-push.jsonc",
		"deploy:pw-generate": "wrangler deploy -c wrangler.pw-generate.jsonc",
		"deploy:review": "wrangler deploy -c wrangler.review.jsonc",
		"dev": "wrangler dev",
		"dev:pw-context": "wrangler dev -c wrangler.pw-context.jsonc",
		"dev:pw-push": "wrangler dev -c wrangler.pw-push.jsonc",
		"dev:pw-generate": "wrangler dev -c wrangler.pw-generate.jsonc",
		"dev:review": "wrangler dev -c wrangler.review.jsonc",
		"deploy:flaky-detective": "wrangler deploy -c wrangler.flaky-detective.jsonc",
		"dev:flaky-detective": "wrangler dev -c wrangler.flaky-detective.jsonc",
		"start": "wrangler dev",
		"test": "vitest",
		"test:unit": "vitest run -c vitest.unit.config.js",
		"test:integration": "vitest run -c vitest.config.js"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.12.4",
		"vitest": "~3.2.0",
		"wrangler": "^4.71.0"
	}
}