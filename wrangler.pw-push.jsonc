{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pw-push",
	"main": "src/pw-push-worker.js",
	"compatibility_date": "2026-03-01",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	]
