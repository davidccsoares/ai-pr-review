{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pw-context",
	"main": "src/pw-context-worker.js",
	"compatibility_date": "2026-03-01",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Service Bindings — inter-worker calls don't count as subrequests!
	"services": [
		{ "binding": "PW_GENERATE", "service": "pw-generate" },
		{ "binding": "PW_PUSH", "service": "pw-push" }
	],
	// KV namespace for .md doc caching (saves 3 subrequests when cache is warm)
	"kv_namespaces": [
		{ "binding": "BOT_KV", "id": "2360521973a242ffb6a2173389758694" }
	],
	"vars": {
		"AZURE_ORG": "https://dev.azure.com/bindtuning"
	}
	// No AI binding needed — AI calls handled by pw-generate worker
}
